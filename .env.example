# =============================================================================
# Global Transport · Inteligencia Comex — variables de entorno
# Copia este archivo a `.env` (local) o crea los mismos nombres como
# "Secrets" en GitHub → Settings → Secrets and variables → Actions.
# Ninguna variable es obligatoria para `--dry-run`: si falta una credencial,
# el conector correspondiente se marca como "skipped" y el pipeline continúa.
# =============================================================================

# --- Claude API (Fase 2: curación) -------------------------------------------
# Se acepta CLAUDE_API_KEY (nombre del PRD) o ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Búsqueda indexada (Brave Search API) -------------------------------------
# https://api-dashboard.search.brave.com → plan "Free" → API key
BRAVE_API_KEY=
# Pausa entre consultas (el plan gratuito permite 1 consulta/segundo)
BRAVE_MIN_INTERVAL_SECONDS=1.1

# --- Buzón de boletines (IMAP) -------------------------------------------------
# Cuenta dedicada suscrita a los boletines (CCL, Andina, Agraria.pe, gCaptain,
# UNCTAD, Gestión). Para Gmail: imap.gmail.com + "contraseña de aplicación".
NEWSLETTER_INBOX_IMAP=imap.gmail.com
NEWSLETTER_INBOX_PORT=993
NEWSLETTER_INBOX_USER=
NEWSLETTER_INBOX_PASS=
NEWSLETTER_INBOX_FOLDER=INBOX

# --- Envío del newsletter (SMTP) -----------------------------------------------
SENDER_EMAIL=
SENDER_NAME=Global Transport · Inteligencia Comex
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true = STARTTLS (puerto 587); false = SSL directo (puerto 465)
SMTP_STARTTLS=true
# Lista separada por comas; para añadir destinatarios no hace falta tocar código
RECIPIENTS=wca.sales@gt.com.pe

# --- Web App / PWA ---------------------------------------------------------------
# URL pública de GitHub Pages (se usa en el CTA del correo y para el logo)
APP_BASE_URL=https://lucas09lu.github.io/NEWSLETTER-GT/

# --- Rutas y ajustes generales -------------------------------------------------
SOURCES_XLSX=data/fuentes-comercio-exterior-peru.xlsx
DATA_DIR=data
OUTPUT_DIR=out
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
